            };
            _btnPdf.FlatAppearance.BorderColor = Color.FromArgb(208, 225, 253);
            _btnPdf.FlatAppearance.BorderSize = 1;
            _btnPdf.Click += (s, e) => ExportActiveReportToPdf();

            _btnPrint = new Button
