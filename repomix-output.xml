            {
                System.Diagnostics.Debug.WriteLine($"[PublishersPanel.BtnDelete_Click] {ex}");
                MessageBox.Show("Could not delete publisher. Please try again.", "Database Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
